[Unit]
Description=Hyprland Attack Shark Mouse Workspace Modifier Daemon
After=graphical-session.target

[Service]
# %h expands to the user home directory in systemd user units
ExecStart=/usr/bin/python3 %h/.local/bin/hypr-mouse-workspace.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
